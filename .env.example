# LLM provider — OpenAI-compatible base URL (must end at /v1 or equivalent)
LLM_BASE_URL=https://api.openai.com/v1

# Your API key for the LLM provider
LLM_API_KEY=your_api_key_here

# Model to use — must support JSON-mode responses
LLM_MODEL=gpt-4o

# Database connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/trao

# Session secret for signing cookies
SESSION_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars

# Optional: set to "true" to allow localhost/private-IP company URLs
# ONLY for non-production evaluation against local test servers.
# Never enable in production.
ALLOW_PRIVATE_URLS=true
